{
  "name": "dsh-wayland-use",
  "version": "0.2.0",
  "description": "DSH plugin: fast native desktop control on Wayland (GNOME/Mutter). Resident backend over RemoteDesktop + ScreenCast — sub-10ms input, screenshot in ~2ms, batch actions with one screenshot, click-by-text via OCR.",
  "type": "module",
  "license": "MIT",
  "author": "Ganglith",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ganglith/dsh-wayland-use.git"
  },
  "homepage": "https://github.com/Ganglith/dsh-wayland-use#readme",
  "bugs": {
    "url": "https://github.com/Ganglith/dsh-wayland-use/issues"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/daemon.py",
    "cordis.patch.yml",
    "package.json"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "wayland",
    "gnome",
    "mutter",
    "computer-use",
    "desktop-automation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
